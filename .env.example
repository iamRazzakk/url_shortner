# ==============================
# Server
# ==============================
IP=localhost
PORT=5000
NODE_ENV=development

# ==============================
# Database (MongoDB)
# ==============================
DATABASE_URL=mongodb://localhost:27017/url_shortener

# ==============================
# Security
# ==============================
BCRYPT_SALT_ROUNDS=12

# ==============================
# JWT
# ==============================
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-this-in-production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=shortUrl-api
JWT_AUDIENCE=shortUrl-client
tokenVersion=1

# ==============================
# Redis / BullMQ (user email worker)
# ==============================
BULLMQIP=127.0.0.1
BULLMQPORT=6379
REDIS_PORT=6379

# ==============================
# Email (SMTP)
# ==============================
EMAIL_FROM="ShortUrl <noreply@example.com>"
EMAIL_USER=abdurrazzaksparktech@gmail.com
EMAIL_PASS=yjhk xhzq jgjz iznr
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587

# ==============================
# Admin Seed
# ==============================
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin@123456

# ==============================
# Cookies
# ==============================
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# ==============================
# Short URL
# ==============================
DOMAIN=http://localhost:5000
SHORT_URL_LENGTH=7
BASE62=0123456789abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ
